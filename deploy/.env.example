# Copy to deploy/.env and change every value before starting.
#   cp deploy/.env.example deploy/.env
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build

# REQUIRED: long random site password (at least 12 characters recommended).
BOTARK_WEB_PASSWORD=replace-with-a-long-random-password

# OPTIONAL: preferred production mode, store only a scrypt hash instead of plaintext.
# Generate with:
#   printf '%s' 'your password' | npm run web:hash-password
# Then comment out BOTARK_WEB_PASSWORD above and set the hash below.
# BOTARK_WEB_PASSWORD_HASH='scrypt$16384$8$1$...'
# Or mount a Docker secret and use:
# BOTARK_WEB_PASSWORD_FILE=/run/secrets/botark_web_password

# API keys are generated/revoked from the admin Settings UI, not from this file.
# Optional: only needed for a browser-based external API client on another origin.
# BOTARK_API_CORS_ORIGIN=https://app.example.com

# Session lifetime in hours.
BOTARK_WEB_SESSION_HOURS=12

# Port on the host loopback interface that SafeLine should reverse-proxy to.
BOTARK_WEB_PUBLISH_PORT=29178

# SafeLine runs on the same host and terminates TLS.
# Trust X-Forwarded-For / X-Forwarded-Proto from it:
BOTARK_WEB_TRUST_PROXY=1
# Set to 1 for HTTPS in production; SafeLine also sends X-Forwarded-Proto.
BOTARK_WEB_COOKIE_SECURE=0
# Optional; only needed if SafeLine rewrites the Host header:
# BOTARK_WEB_PUBLIC_ORIGIN=https://botark.example.com
